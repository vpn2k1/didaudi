# Sao chép thành web/.env.local (KHÔNG commit). Các biến NEXT_PUBLIC_* sẽ lộ ra trình duyệt – chỉ đặt giá trị công khai.

# URL backend (chỉ dùng phía server Next.js: rewrite /api và render SSR)
BACKEND_URL=http://localhost:4000

# URL công khai của website (canonical, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cho phép công cụ tìm kiếm index (sitemap/robots). Để false ở local/staging.
# Kể cả khi bật, chỉ trang có địa điểm đã xác minh (không phải dữ liệu minh họa) mới được index.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Bản đồ: maplibre (mặc định) | mapbox | none (ẩn bản đồ, chỉ dùng danh sách)
NEXT_PUBLIC_MAP_PROVIDER=maplibre
# Style MapLibre. Mặc định OpenFreeMap (miễn phí, có attribution OSM).
# Production nên dùng nhà cung cấp có SLA (vd. MapTiler – key giới hạn theo domain) hoặc tự host tiles.
NEXT_PUBLIC_MAP_STYLE_URL=
# Chỉ cần khi NEXT_PUBLIC_MAP_PROVIDER=mapbox. Dùng public token (pk.*) có giới hạn URL.
NEXT_PUBLIC_MAPBOX_TOKEN=
