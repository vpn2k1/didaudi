# Sao chép thành be/.env (KHÔNG commit file .env). Biến để trống = chưa bật.

PORT=4000
NODE_ENV=development

# Nguồn dữ liệu địa điểm: local (dữ liệu nội bộ/minh họa, mặc định) | google
PLACES_PROVIDER=local
# Server key cho Places API (New). Chỉ dùng ở server – không bao giờ đặt ở frontend.
# Giới hạn key theo API (Places API New) + IP server, bật quota & budget alert trong Google Cloud.
GOOGLE_PLACES_API_KEY=

# Bật trang quản trị (/admin). Để trống cả hai = admin tắt hoàn toàn (API trả 503).
# Mật khẩu ≥ 12 ký tự; secret ≥ 32 ký tự ngẫu nhiên, ví dụ: openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Đặt 1 nếu chạy sau 1 reverse proxy (để rate limit lấy đúng IP)
TRUST_PROXY=0
